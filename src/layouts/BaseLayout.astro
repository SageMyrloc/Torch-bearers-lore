---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Torchbearers",
  description = "Lore from the Veil of Aeluran"
} = Astro.props;
const pageTitle = title === "Torchbearers" ? title : `${title} · Torchbearers`;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111713" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={Astro.url} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={base} aria-label="Torchbearers home">
        <span class="brand-mark" aria-hidden="true">✦</span>
        <span><strong>Torchbearers</strong><small>Lore of the Veil</small></span>
      </a>
      <nav aria-label="Primary navigation">
        <a href={base}>Home</a>
        <a href={`${base}lore/`}>Lore library</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <span>The light holds—for now.</span>
      <a href={`${base}lore/`}>Explore the archive</a>
    </footer>
  </body>
</html>
